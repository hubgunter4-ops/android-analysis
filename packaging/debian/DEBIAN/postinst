#!/bin/bash
set -Eeuo pipefail

chmod 755 /usr/share/android-analysis/src/no4nn.sh
chmod 755 /usr/share/android-analysis/src/android_toolchain/traces.sh
chmod 755 /usr/share/android-analysis/src/android_toolchain/encrypt.sh
chmod 755 /usr/share/android-analysis/android-app/build-local.sh
chmod 755 /usr/share/android-analysis/android-app/gradlew
chmod 755 /usr/share/android-analysis/install.sh
chmod 755 /usr/share/android-analysis/src/no4nn_gui.py
chmod 755 /usr/bin/android-analysis

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

exit 0
